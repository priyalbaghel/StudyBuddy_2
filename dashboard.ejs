<%- include('partials/header') %><section class="dash-head"><div><div class="eyebrow">YOUR STUDY SPACE</div><h1>Good morning, <%= user.name.split(' ')[0] %>.</h1><p>Small steps today make confident answers tomorrow.</p></div><a class="button button-primary" href="/upload">+ Upload PDF</a></section><section class="stat-grid"><div class="stat-card"><span class="stat-icon purple">◫</span><small>Documents</small><strong><%= documents.length %></strong><span class="muted">in your library</span></div><div class="stat-card"><span class="stat-icon yellow">✦</span><small>Study streak</small><strong>3 <i>days</i></strong><span class="muted">Keep it going</span></div><div class="stat-card"><span class="stat-icon green">◎</span><small>Focus score</small><strong>72%</strong><span class="muted">You’re building momentum</span></div></section><section class="dashboard-grid"><div class="panel"><div class="panel-head"><div><h2>Productivity Overview</h2><p>Your learning rhythm this week</p></div><span class="pill">This week</span></div><div class="chart"><canvas id="progressChart" height="150"></canvas></div></div><div class="panel events-mini"><div class="panel-head"><div><h2>Coming up</h2><p>Your next study moments</p></div><a href="/calendar">View all</a></div><% if (!events.length) { %><div class="empty">No upcoming events yet.<br><a href="/calendar">Plan one now →</a></div><% } %><% events.forEach(event => { %><div class="event-row"><span class="date-box"><b><%= new Date(event.eventDate).toLocaleDateString('en-US',{day:'2-digit'}) %></b><small><%= new Date(event.eventDate).toLocaleDateString('en-US',{month:'short'}) %></small></span><span><strong><%= event.title %></strong><small><%= event.category %></small></span></div><% }) %></div></section><section class="panel library"><div class="panel-head"><div><h2>Your library</h2><p>Pick up right where you left off</p></div><a href="/upload">Add document +</a></div><% if (!documents.length) { %><div class="drop-empty"><span>◫</span><h3>Your library is waiting</h3><p>Upload a PDF to turn it into smart study material.</p><a class="button button-secondary" href="/upload">Upload your first PDF</a></div><% } else { %><div class="doc-list"><% documents.forEach(doc => { %><a class="doc-row" href="/document/<%= doc._id %>"><span class="pdf-icon">PDF</span><span><strong><%= doc.title %></strong><small><%= doc.fileName %> · <%= new Date(doc.createdAt).toLocaleDateString() %></small></span><span class="arrow">→</span></a><% }) %></div><% } %></section><script src="https://cdn.jsdelivr.net/npm/chart.js"></script><%- include('partials/footer') %>
