<%- include('partials/header') %><div class="auth-wrap"><div class="auth-card"><div class="eyebrow">WELCOME TO STUDYBUDDY</div><h1>Create your account</h1><p>Set up your focused study space in a minute.</p><% if (error) { %><div class="alert"><%= error %></div><% } %><form method="post" action="/signup"><label>Name<input name="name" required placeholder="Your name"></label><label>Email<input type="email" name="email" required placeholder="you@example.com"></label><label>Password<input type="password" name="password" minlength="6" required placeholder="At least 6 characters"></label><button class="button button-primary wide">Create account →</button></form><p class="form-foot">Already a member? <a href="/login">Log in</a></p></div></div><%- include('partials/footer') %>
